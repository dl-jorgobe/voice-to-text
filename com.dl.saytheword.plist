<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dl.saytheword</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Say the word.app/Contents/MacOS/Say the word...</string>
    </array>

    <!-- Launch on login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- KeepAlive only restarts after non-clean exits (crashes, jetsam
         kills). A clean Cmd+Q exit stays exited so Daniel can actually
         close the app when he wants. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/Users/daniellindholt/Library/Application Support/Say the word/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/daniellindholt/Library/Application Support/Say the word/launchd.stderr.log</string>
</dict>
</plist>
